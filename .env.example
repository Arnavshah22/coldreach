# Copy to .env and fill in. .env is gitignored; never commit real values.
# Nothing auto-loads this file — the scripts read os.getenv only, so export it
# before running. See the README for the one-liner on PowerShell and bash.

# --- Hunter.io (optional) -------------------------------------------------
# Free plan: 50 domain-searches + 100 verifications a month, resetting the 24th.
# Without a key, find_emails.py falls back to SMTP probing and outreach_agent.py
# runs scrape-only. https://hunter.io/api-keys
HUNTER_API_KEY=

# --- Sending mailbox ------------------------------------------------------
# Gmail shown; any SMTP host works. Read the deliverability section of the
# README before pointing this at a mailbox you care about.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
FROM_NAME=Your Name

# NOT your account password — Gmail has rejected those over SMTP since 2022.
# Generate a 16-character App Password (needs 2-Step Verification turned on):
#   https://myaccount.google.com/apppasswords
SMTP_PASS=

# --- Optional -------------------------------------------------------------
# Envelope sender for find_emails.py's legacy SMTP probe path. Unused by the
# outreach_agent cascade.
PROBE_FROM=
